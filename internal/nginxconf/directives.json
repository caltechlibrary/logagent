    "client_max_body_size",
    "default_type",
    "deny",
    "error_log",
    "error_page",
    "expires",
    "fastcgi_pass",
    "gzip",
    "http2",
    "if",
    "include",
    "index",
    "internal",
    "keepalive_timeout",
    "limit_conn",
    "limit_req",
    "listen",
    "location",
    "log_not_found",
    "proxy_cache",
    "proxy_http_version",
    "proxy_pass",
    "proxy_read_timeout",
    "proxy_redirect",
    "proxy_set_header",
    "real_ip_header",
    "resolver",
    "return",
    "rewrite",
    "root",
    "send_timeout",
    "sendfile",
    "server_tokens",
    "set",
    "set_real_ip_from",
    "ssl_certificate",
